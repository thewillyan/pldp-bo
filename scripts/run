#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import pathlib
import re
import subprocess
import sys
from dataclasses import dataclass

import mlflow
import yaml

from src.config.loader import ExperimentConfig, load_config
from src.config.locked import METHOD_NAMES
from src.config.locked import config_version as locked_config_version

CONFIG_DIR = pathlib.Path("config/experiments")
_PLOT_SCRIPT = str(pathlib.Path(__file__).resolve().parent / "plot")


def _partition_label(cfg: ExperimentConfig) -> str:
    """§4.1 partition label (mirror of src.tracking.tracker.partition_label)."""
    pt = cfg.data.partition_type
    if pt == "noniid":
        return "dirichlet_0.5"
    if pt == "dirichlet":
        return f"dirichlet_{cfg.data.partition_alpha}"
    if pt == "writer":
        return "natural"
    return pt


@dataclass
class MatrixRun:
    """One (cell, method, seed) matrix run and its inventory status."""

    cell: str  # "<dataset>_<partition>" (the MLflow experiment name)
    method: str
    seed: int
    run_name: str
    status: str  # "done" | "failed" | "missing"
    run_id: str | None = None
    config_path: str = ""


def _parse_seeds(spec: str) -> list[int]:
    """Parse 'A-B' or 'N' into a seed list (e.g. '0-11' → 0..11)."""
    if "-" in spec:
        start, end = spec.split("-", 1)
        return list(range(int(start), int(end) + 1))
    return [int(spec)]


def _resolve_run_id(
    tracking_uri: str, run_name: str, experiment: str | None = None,
) -> str | None:
    prev_uri = mlflow.get_tracking_uri()
    mlflow.set_tracking_uri(tracking_uri)
    try:
        client = mlflow.tracking.MlflowClient()
        if experiment is not None:
            exp = client.get_experiment_by_name(experiment)
            if exp is None:
                return None
            experiment_ids = [exp.experiment_id]
        else:
            experiment_ids = [exp.experiment_id for exp in client.search_experiments()]
        escaped = run_name.replace("\\", "\\\\").replace("'", "\\'")
        runs = client.search_runs(
            experiment_ids=experiment_ids,
            filter_string=f"attributes.run_name = '{escaped}'",
            order_by=["start_time DESC"],
            max_results=1,
        )
        return runs[0].info.run_id if runs else None
    finally:
        mlflow.set_tracking_uri(prev_uri)


def _resolve_run_ids_by_prefix(
    tracking_uri: str, name_prefix: str,
) -> dict[str, str]:
    prev_uri = mlflow.get_tracking_uri()
    mlflow.set_tracking_uri(tracking_uri)
    try:
        client = mlflow.tracking.MlflowClient()
        experiment_ids = [exp.experiment_id for exp in client.search_experiments()]
        runs = client.search_runs(experiment_ids=experiment_ids, order_by=["attributes.run_name ASC"])
        return {
            r.info.run_name: r.info.run_id
            for r in runs
            if r.info.run_name is not None and r.info.run_name.startswith(name_prefix)
        }
    except Exception as exc:
        print(f"Error querying {tracking_uri}: {exc}", file=sys.stderr)
        return {}
    finally:
        mlflow.set_tracking_uri(prev_uri)


def _parse_seed(run_name: str, base_name: str) -> int | None:
    prefix = f"{base_name}_seed"
    if run_name.startswith(prefix):
        try:
            return int(run_name[len(prefix):])
        except ValueError:
            return None
    return None


def _replot_runs(
    tracking_uri: str,
    run_ids_seeds: list[tuple[str, int | None]],
    plots_base_dir: pathlib.Path,
) -> None:
    if not run_ids_seeds:
        return

    is_multi = len(run_ids_seeds) > 1

    for run_id, seed in run_ids_seeds:
        save_dir = plots_base_dir / f"seed{seed}" if (is_multi and seed is not None) else plots_base_dir
        save_dir.mkdir(parents=True, exist_ok=True)

        plot_proc = subprocess.run(
            [sys.executable, _PLOT_SCRIPT, "--tracking-uri", tracking_uri,
             "plot", run_id, "--type", "all", "--save-dir", str(save_dir)],
            capture_output=True, text=True,
        )
        for line in plot_proc.stdout.splitlines():
            if line.strip():
                print(line)
        for line in plot_proc.stderr.splitlines():
            if line.strip():
                print(line, file=sys.stderr)
        if plot_proc.returncode != 0:
            tag = f" for seed {seed}" if seed is not None else ""
            print(f"  WARNING: Plot generation failed{tag}", file=sys.stderr)

    if is_multi:
        mean_dir = plots_base_dir / "mean"
        mean_dir.mkdir(parents=True, exist_ok=True)
        run_ids = [rid for rid, _ in run_ids_seeds]
        plot_proc = subprocess.run(
            [sys.executable, _PLOT_SCRIPT, "--tracking-uri", tracking_uri,
             "compare", "--runs", *run_ids, "--mean",
             "--type", "convergence", "--save-dir", str(mean_dir)],
            capture_output=True, text=True,
        )
        for line in plot_proc.stdout.splitlines():
            if line.strip():
                print(line)
        for line in plot_proc.stderr.splitlines():
            if line.strip():
                print(line, file=sys.stderr)
        if plot_proc.returncode != 0:
            print("  WARNING: Mean plot generation failed", file=sys.stderr)


def _needs_quoting(val: str) -> bool:
    try:
        float(val)
        return False
    except ValueError:
        return True


_SQLITE_URI_RE = re.compile(r"^sqlite:///(.+)")


def _json_save_dir(tracking_uri: str) -> pathlib.Path:
    m = _SQLITE_URI_RE.match(tracking_uri)
    if m:
        db_path = pathlib.Path(m.group(1))
        return db_path.parent / "json"
    return pathlib.Path("json")


def _parse_json_from_stream(
    line: str, buffer: list[str], depth: int
) -> tuple[dict[str, object] | None, int]:
    stripped = line.rstrip("\n").rstrip("\r")
    for ch in stripped:
        if ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
    if buffer or depth > 0 or "{" in stripped:
        buffer.append(stripped)
    if depth == 0 and buffer:
        try:
            data = json.loads("\n".join(buffer))
            if isinstance(data, dict):
                return data, 0
        except json.JSONDecodeError:
            pass
        buffer.clear()
    return None, depth


def cmd_single(
    config_path: str, num_clients: int, overrides: list[str],
    experiment: str | None = None,
) -> tuple[str, str] | None:
    """Run one config via ``flwr run``; returns (mlflow_run_id, tracking_uri).

    ``experiment`` scopes the post-run id resolution to a single MLflow
    experiment (required for matrix runs, where run names repeat across
    cells); None keeps the legacy all-experiments lookup.
    """
    path = pathlib.Path(config_path)
    if not path.exists():
        print(f"Error: config '{config_path}' not found", file=sys.stderr)
        return None
    if num_clients < 2:
        print("Error: num_clients must be an integer >= 2", file=sys.stderr)
        return None

    with open(path) as f:
        cfg = yaml.safe_load(f)
    run_name = cfg.get("logging", {}).get("run_name", "")
    cfg_tracking_uri = cfg.get("logging", {}).get("tracking_uri")

    env_uri = os.environ.get("MLFLOW_TRACKING_URI")
    if env_uri:
        tracking_uri = env_uri
    elif cfg_tracking_uri:
        tracking_uri = cfg_tracking_uri
    else:
        try:
            name = str(path.relative_to(CONFIG_DIR)).replace("/", "_").replace(path.suffix, "")
        except ValueError:
            name = f"{path.stem}_{hash(path.resolve()) & 0xFFFFFFFF:08x}"
        single_dir = pathlib.Path(f"mlruns/single/{name}")
        single_dir.mkdir(parents=True, exist_ok=True)
        tracking_uri = f"sqlite:///{single_dir}/mlflow.db"

    app_overrides: dict[str, str] = {}
    for ov in overrides:
        if "=" not in ov:
            print(f"Warning: ignoring invalid override '{ov}'", file=sys.stderr)
            continue
        key, val = ov.split("=", 1)
        app_overrides[key] = val
        if key == "logging.run_name":
            run_name = val

    run_config_parts = [
        f"config-path='{config_path}'",
        f"data.num_clients={num_clients}",
        f"federated.min_available_nodes={num_clients}",
    ]
    if app_overrides:
        run_config_parts.append(
            f"app_config_overrides='{json.dumps(app_overrides)}'"
        )

    cmd = [
        "flwr", "run", ".",
        "--stream",
        "--format", "json",
        "--run-config", " ".join(run_config_parts),
        "--federation-config", f"num-supernodes={num_clients}",
    ]

    process_env = os.environ | {"MLFLOW_TRACKING_URI": tracking_uri}
    process = subprocess.Popen(
        cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, bufsize=1,
        env=process_env,
    )
    assert process.stdout is not None
    assert process.stderr is not None

    flwr_json = None
    json_buffer: list[str] = []
    json_depth = 0
    for line in process.stdout:
        sys.stdout.write(line)
        sys.stdout.flush()
        if flwr_json is None:
            parsed, json_depth = _parse_json_from_stream(line, json_buffer, json_depth)
            if parsed is not None:
                flwr_json = parsed

    for line in process.stderr:
        sys.stderr.write(line)
        sys.stderr.flush()

    process.wait()

    run_id = None
    if process.returncode == 0 and run_name:
        run_id = _resolve_run_id(tracking_uri, run_name, experiment=experiment)
        if run_id is None and cfg_tracking_uri:
            run_id = _resolve_run_id(cfg_tracking_uri, run_name, experiment=experiment)

    if flwr_json:
        json_dir = _json_save_dir(tracking_uri)
        json_dir.mkdir(parents=True, exist_ok=True)
        stem = path.stem
        fname = f"{stem}-{flwr_json.get('run-id', 'unknown')}.json"
        if run_id:
            flwr_json["mlflow-run-id"] = run_id
        (json_dir / fname).write_text(json.dumps(flwr_json, indent=2))

    if run_id is None:
        return None
    return run_id, tracking_uri


def _matrix_cells(
    config_dir: pathlib.Path,
    datasets: list[str] | None = None,
    partitions: list[str] | None = None,
    methods: list[str] | None = None,
) -> list[tuple[pathlib.Path, str, str, str]]:
    """Matrix cells (path, dataset, partition, method) from the generated configs.

    Configs whose ``method`` is not a §3 method (e.g. legacy/archive leftovers)
    are skipped. Filters are exact matches on dataset / partition label / method.
    """
    datasets = datasets or []
    partitions = partitions or []
    methods = methods or []
    cells: list[tuple[pathlib.Path, str, str, str]] = []
    for path in sorted(config_dir.glob("*.yaml")):
        cfg = load_config(str(path))
        if cfg.method not in METHOD_NAMES:
            continue
        dataset = cfg.data.name.lower()
        partition = _partition_label(cfg)
        if datasets and dataset not in datasets:
            continue
        if partitions and partition not in partitions:
            continue
        if methods and cfg.method not in methods:
            continue
        cells.append((path, dataset, partition, cfg.method))
    return cells


def matrix_inventory(
    tracking_uri: str,
    config_dir: pathlib.Path,
    seeds: list[int],
    datasets: list[str] | None = None,
    partitions: list[str] | None = None,
    methods: list[str] | None = None,
) -> list[MatrixRun]:
    """Classify every (cell, method, seed) against the tracking DB (§3 run policy).

    ``done`` = run exists, status FINISHED, and its ``config_version`` tag
    matches the current §2 constants hash. Anything else (no run, crashed,
    stale tag) is ``failed``/``missing`` and must be rerun. Lookups are scoped
    to the run's own experiment — run names repeat across cells.
    """
    prev_uri = mlflow.get_tracking_uri()
    mlflow.set_tracking_uri(tracking_uri)
    try:
        client = mlflow.tracking.MlflowClient()
        runs_by_exp: dict[str, dict[str, object]] = {}
        for exp in client.search_experiments():
            runs = client.search_runs(
                experiment_ids=[exp.experiment_id], max_results=50_000,
            )
            runs_by_exp[exp.name] = {
                r.info.run_name: r for r in runs if r.info.run_name is not None
            }
        expected_version = locked_config_version()
        inventory: list[MatrixRun] = []
        for path, dataset, partition, method in _matrix_cells(
            config_dir, datasets, partitions, methods,
        ):
            cell = f"{dataset}_{partition}"
            exp_runs = runs_by_exp.get(cell, {})
            for seed in seeds:
                run_name = f"{method}_seed{seed}"
                run = exp_runs.get(run_name)
                if run is None:
                    inventory.append(
                        MatrixRun(
                            cell, method, seed, run_name, "missing",
                            config_path=str(path),
                        ),
                    )
                    continue
                tags = (run.data.tags or {})
                if run.info.status == "FINISHED" and tags.get("config_version") == expected_version:
                    status = "done"
                else:
                    status = "failed"
                inventory.append(
                    MatrixRun(
                        cell, method, seed, run_name, status, run.info.run_id,
                        config_path=str(path),
                    ),
                )
        return inventory
    finally:
        mlflow.set_tracking_uri(prev_uri)


def matrix_plan(inventory: list[MatrixRun]) -> list[MatrixRun]:
    """Runs that still need to execute (everything not ``done``), stable order."""
    return [r for r in inventory if r.status != "done"]


def _print_inventory(inventory: list[MatrixRun]) -> None:
    rows: dict[tuple[str, str], list[str]] = {}
    for r in inventory:
        rows.setdefault((r.cell, r.method), []).append(r.status)
    print(f"{'cell':<18} {'method':<18} {'done':>4} {'failed':>6} {'missing':>7}")
    for (cell, method), statuses in sorted(rows.items()):
        print(
            f"{cell:<18} {method:<18} "
            f"{statuses.count('done'):>4} {statuses.count('failed'):>6} "
            f"{statuses.count('missing'):>7}",
        )
    totals = {s: sum(r.status == s for r in inventory) for s in ("done", "failed", "missing")}
    print(
        "=== totals === "
        f"done: {totals['done']}  failed: {totals['failed']}  "
        f"missing: {totals['missing']}",
    )


def run_matrix(
    tracking_uri: str, plan: list[MatrixRun], num_clients: int | None = None,
) -> None:
    """Execute the pending matrix runs (§3 run policy).

    Rerun policy: a stale/crashed run with the same (experiment, run name) is
    deleted first, then the cell is relaunched with the same seed, so reruns
    overwrite the same run name with a fresh run id. After the launch the run
    is resolved experiment-scoped and its final status is reported.
    """
    prev_uri = mlflow.get_tracking_uri()
    mlflow.set_tracking_uri(tracking_uri)
    try:
        client = mlflow.tracking.MlflowClient()
        os.environ["MLFLOW_TRACKING_URI"] = tracking_uri
        for run in plan:
            if run.run_id is not None:
                client.delete_run(run.run_id)
            n_clients = num_clients
            if n_clients is None:
                n_clients = load_config(run.config_path).data.num_clients
            print(f"--- {run.cell} {run.run_name} ---")
            result = cmd_single(
                run.config_path, n_clients, [f"seed={run.seed}"],
                experiment=run.cell,
            )
            if result is None:
                print(
                    f"  ERROR: launch failed for {run.run_name}",
                    file=sys.stderr,
                )
                continue
            new_run_id = _resolve_run_id(tracking_uri, run.run_name, experiment=run.cell)
            if new_run_id is None:
                print(
                    f"  ERROR: no run found after launch: {run.run_name}",
                    file=sys.stderr,
                )
                continue
            status = client.get_run(new_run_id).info.status
            print(f"  {run.run_name} -> {status} ({new_run_id})")
    finally:
        mlflow.set_tracking_uri(prev_uri)


def cmd_matrix(args: argparse.Namespace) -> None:
    tracking_uri = (
        args.tracking_uri
        or os.environ.get("MLFLOW_TRACKING_URI")
        or "sqlite:///./mlflow.db"
    )
    seeds = _parse_seeds(args.seeds)
    inventory = matrix_inventory(
        tracking_uri,
        CONFIG_DIR,
        seeds,
        datasets=args.dataset or None,
        partitions=args.partition or None,
        methods=args.method or None,
    )
    if not inventory:
        print(f"No matrix configs found in {CONFIG_DIR}", file=sys.stderr)
        sys.exit(1)
    print(f"=== Matrix inventory (tracking: {tracking_uri}) ===")
    _print_inventory(inventory)
    plan = matrix_plan(inventory)
    if args.dry_run:
        print(f"Dry run: {len(plan)} runs would execute")
        return
    run_matrix(tracking_uri, plan, num_clients=args.num_clients)


def cmd_list() -> None:
    """List the available experiment configs."""
    configs = sorted(CONFIG_DIR.glob("*.yaml"))
    if not configs:
        print("No configs found.")
        return
    for f in configs:
        print(f.name)


def cmd_replot_single(
    config_path: str,
    num_runs: int | None = None,
    tracking_uri: str | None = None,
) -> None:
    path = pathlib.Path(config_path)
    if not path.exists():
        print(f"Error: config '{config_path}' not found", file=sys.stderr)
        sys.exit(1)

    with open(path) as f:
        cfg = yaml.safe_load(f)
    base_run_name = cfg.get("logging", {}).get("run_name", path.stem)

    if tracking_uri is None:
        cfg_tracking_uri = cfg.get("logging", {}).get("tracking_uri")
        env_uri = os.environ.get("MLFLOW_TRACKING_URI")
        if env_uri:
            tracking_uri = env_uri
        elif cfg_tracking_uri:
            tracking_uri = cfg_tracking_uri
        else:
            try:
                name = str(path.relative_to(CONFIG_DIR)).replace("/", "_").replace(path.suffix, "")
            except ValueError:
                name = f"{path.stem}_{hash(path.resolve()) & 0xFFFFFFFF:08x}"
            tracking_uri = f"sqlite:///mlruns/single/{name}/mlflow.db"

    runs_by_name = _resolve_run_ids_by_prefix(tracking_uri, base_run_name)
    if not runs_by_name:
        print(
            f"No runs found with name prefix '{base_run_name}' at {tracking_uri}",
            file=sys.stderr,
        )
        sys.exit(1)

    seeded: list[tuple[int, str]] = []
    exact: list[str] = []
    for run_name, run_id in runs_by_name.items():
        seed = _parse_seed(run_name, base_run_name)
        if seed is not None:
            seeded.append((seed, run_id))
        else:
            exact.append(run_id)

    if num_runs is not None:
        is_multi = num_runs > 1
    else:
        is_multi = len(seeded) > 0

    if is_multi:
        if not seeded:
            print("Error: expected seeded runs but none found", file=sys.stderr)
            sys.exit(1)
        seeded.sort(key=lambda x: x[0])
        if num_runs is not None and len(seeded) != num_runs:
            print(
                f"Warning: expected {num_runs} seeded runs, found {len(seeded)}",
                file=sys.stderr,
            )
        entries = [(rid, s) for s, rid in seeded]
    else:
        if exact:
            entries = [(exact[0], None)]
        elif len(seeded) == 1:
            entries = [(seeded[0][1], None)]
        else:
            print("Error: could not determine run", file=sys.stderr)
            sys.exit(1)

    config_stem = path.stem
    plots_base = pathlib.Path(f"mlruns/single/{config_stem}/plots")
    _replot_runs(tracking_uri, entries, plots_base)

    print(f"Regenerated plots for {len(entries)} run(s) in {plots_base}")


def main() -> None:
    parser = argparse.ArgumentParser(description="PLDP-BO experiment runner")
    sub = parser.add_subparsers(dest="command", required=True)

    p_single = sub.add_parser("single", help="Run a single experiment")
    p_single.add_argument("config_path", type=str)
    p_single.add_argument("num_clients", type=int)
    p_single.add_argument("overrides", nargs="*", help="KEY=VALUE overrides")
    p_single.add_argument(
        "--num-runs", "-n", type=int, default=1,
        help="Number of runs with different seeds (default: 1)",
    )

    sub.add_parser("list", help="List available experiment configs")

    p_matrix = sub.add_parser(
        "matrix", help="Run or inventory the §3 experiment matrix",
    )
    p_matrix.add_argument(
        "--dry-run", action="store_true",
        help="print the §6.1-style inventory only, do not run anything",
    )
    p_matrix.add_argument(
        "--dataset", nargs="*", default=[],
        help="filter datasets (mnist, cifar100, femnist)",
    )
    p_matrix.add_argument(
        "--partition", nargs="*", default=[],
        help="filter partitions (iid, dirichlet_0.5, dirichlet_0.1, "
             "dirichlet_1.0, pathological, natural)",
    )
    p_matrix.add_argument(
        "--method", nargs="*", default=[],
        help="filter methods (nonprivate, dpfedavg_fixed, fedprox_fixed, pldpbo_*)",
    )
    p_matrix.add_argument(
        "--seeds", type=str, default="0-11",
        help="seed range 'A-B' or single 'N' (default: 0-11)",
    )
    p_matrix.add_argument(
        "--tracking-uri", type=str, default=None,
        help="MLflow tracking URI (default: MLFLOW_TRACKING_URI or sqlite:///./mlflow.db)",
    )
    p_matrix.add_argument(
        "--num-clients", type=int, default=None,
        help="override the client count for the flwr launch (default: from config)",
    )

    p_replot = sub.add_parser("replot", help="Regenerate plots from existing runs")
    replot_sub = p_replot.add_subparsers(dest="replot_command", required=True)

    p_replot_single = replot_sub.add_parser("single", help="Regenerate plots for a single experiment")
    p_replot_single.add_argument("config_path", type=str)
    p_replot_single.add_argument(
        "-n", "--num-runs", type=int, default=None,
        help="Number of seeded runs (auto-detected if omitted)",
    )
    p_replot_single.add_argument(
        "--tracking-uri", type=str, default=None,
        help="MLflow tracking URI (auto-detected if omitted)",
    )

    args = parser.parse_args()

    if args.command == "single":
        if args.num_runs > 1:
            path = pathlib.Path(args.config_path)
            cfg = yaml.safe_load(path.read_text())
            base_seed = cfg.get("seed", 42)
            base_run_name = cfg.get("logging", {}).get("run_name", path.stem)

            effective_base_seed = base_seed
            effective_base_run_name = base_run_name
            filtered_overrides: list[str] = []
            for ov in args.overrides:
                if ov.startswith("seed="):
                    effective_base_seed = int(ov.split("=", 1)[1])
                elif ov.startswith("logging.run_name="):
                    effective_base_run_name = ov.split("=", 1)[1]
                else:
                    filtered_overrides.append(ov)

            first_seed = effective_base_seed
            first_run_name = f"{effective_base_run_name}_seed{first_seed}"
            first_overrides = filtered_overrides + [
                f"seed={first_seed}", f"logging.run_name={first_run_name}",
            ]
            first_result = cmd_single(args.config_path, args.num_clients, first_overrides)
            if first_result is None:
                sys.exit(1)
            run_id_first, tracking_uri = first_result

            os.environ["MLFLOW_TRACKING_URI"] = tracking_uri
            run_ids = [run_id_first]

            for i in range(1, args.num_runs):
                seed = effective_base_seed + i
                run_name = f"{effective_base_run_name}_seed{seed}"
                overrides = filtered_overrides + [
                    f"seed={seed}", f"logging.run_name={run_name}",
                ]
                result = cmd_single(args.config_path, args.num_clients, overrides)
                if result is not None:
                    run_ids.append(result[0])

            config_stem = path.stem
            for i, rid in enumerate(run_ids):
                seed = effective_base_seed + i
                seed_dir = pathlib.Path(f"mlruns/single/{config_stem}/plots/seed{seed}")
                seed_dir.mkdir(parents=True, exist_ok=True)
                plot_proc = subprocess.run(
                    [sys.executable, _PLOT_SCRIPT, "--tracking-uri", tracking_uri,
                     "plot", rid, "--type", "all", "--save-dir", str(seed_dir)],
                    capture_output=True, text=True,
                )
                for line in plot_proc.stdout.splitlines():
                    if line.strip():
                        print(line)
                for line in plot_proc.stderr.splitlines():
                    if line.strip():
                        print(line, file=sys.stderr)
                if plot_proc.returncode != 0:
                    print(f"  WARNING: Plot generation failed for seed {seed}", file=sys.stderr)

            if len(run_ids) > 1:
                mean_dir = pathlib.Path(f"mlruns/single/{config_stem}/plots/mean")
                mean_dir.mkdir(parents=True, exist_ok=True)
                plot_proc = subprocess.run(
                    [sys.executable, _PLOT_SCRIPT, "--tracking-uri", tracking_uri,
                     "compare", "--runs", *run_ids, "--mean",
                     "--type", "convergence", "--save-dir", str(mean_dir)],
                    capture_output=True, text=True,
                )
                for line in plot_proc.stdout.splitlines():
                    if line.strip():
                        print(line)
                for line in plot_proc.stderr.splitlines():
                    if line.strip():
                        print(line, file=sys.stderr)
                if plot_proc.returncode != 0:
                    print("WARNING: Mean plot generation failed", file=sys.stderr)

            print(f"Completed {len(run_ids)}/{args.num_runs} runs")
        else:
            result = cmd_single(args.config_path, args.num_clients, args.overrides)
            if result is not None:
                run_id, tracking_uri = result
                print(run_id)

                config_stem = pathlib.Path(args.config_path).stem
                plots_dir = pathlib.Path(f"mlruns/single/{config_stem}/plots")
                plots_dir.mkdir(parents=True, exist_ok=True)

                plot_proc = subprocess.run(
                    [
                        sys.executable, _PLOT_SCRIPT,
                        "--tracking-uri", tracking_uri,
                        "plot", run_id,
                        "--type", "all",
                        "--save-dir", str(plots_dir),
                    ],
                    capture_output=True,
                    text=True,
                )
                for line in plot_proc.stdout.splitlines():
                    if line.strip():
                        print(line)
                for line in plot_proc.stderr.splitlines():
                    if line.strip():
                        print(line, file=sys.stderr)
                if plot_proc.returncode != 0:
                    print("WARNING: Plot generation failed", file=sys.stderr)
    elif args.command == "list":
        cmd_list()
    elif args.command == "matrix":
        cmd_matrix(args)
    elif args.command == "replot" and args.replot_command == "single":
        cmd_replot_single(args.config_path, num_runs=args.num_runs, tracking_uri=args.tracking_uri)



if __name__ == "__main__":
    main()
