#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import pathlib
import subprocess
import sys

import mlflow
import yaml

CONFIG_DIR = pathlib.Path("config/experiments")
_RUN_SCRIPT = str(pathlib.Path(__file__).resolve())
_PLOT_SCRIPT = str(pathlib.Path(__file__).resolve().parent / "plot")


def _get_tracking_uri(config_path: pathlib.Path) -> str:
    env_uri = os.environ.get("MLFLOW_TRACKING_URI")
    if env_uri:
        return env_uri
    with open(config_path) as f:
        cfg = yaml.safe_load(f)
    return cfg.get("logging", {}).get("tracking_uri", "./mlruns")


def _resolve_run_id(config_path: pathlib.Path, run_name: str) -> str | None:
    uri = _get_tracking_uri(config_path)
    mlflow.set_tracking_uri(uri)
    client = mlflow.tracking.MlflowClient()
    experiment_ids = [exp.experiment_id for exp in client.search_experiments()]
    safe_name = run_name.replace('"', '\\"')
    runs = client.search_runs(
        experiment_ids=experiment_ids,
        filter_string=f'attributes.run_name = "{safe_name}"',
        order_by=["start_time DESC"],
        max_results=1,
    )
    return runs[0].info.run_id if runs else None


def cmd_single(config_path: str, num_clients: str, overrides: list[str]) -> None:
    path = pathlib.Path(config_path)
    if not path.exists():
        print(f"Error: config '{config_path}' not found", file=sys.stderr)
        sys.exit(1)
    if not num_clients.isdigit() or int(num_clients) < 2:
        print("Error: num_clients must be an integer >= 2", file=sys.stderr)
        sys.exit(1)

    run_config_parts = [f"config-path='{config_path}'"]
    for ov in overrides:
        if "=" not in ov:
            print(f"Warning: ignoring invalid override '{ov}'", file=sys.stderr)
            continue
        key, val = ov.split("=", 1)
        run_config_parts.append(f"{key}='{val}'")

    cmd = [
        "flwr", "run", ".",
        "--stream",
        "--run-config", " ".join(run_config_parts),
        "--federation-config", f"num-supernodes={num_clients}",
    ]

    result = subprocess.run(cmd)
    if result.returncode != 0:
        sys.exit(result.returncode)

    with open(path) as f:
        cfg = yaml.safe_load(f)
    run_name = cfg.get("logging", {}).get("run_name", "")
    if not run_name:
        return

    run_id = _resolve_run_id(path, run_name)
    if run_id:
        print(run_id)


def cmd_group(group_name: str, num_clients: str) -> None:
    if not num_clients.isdigit() or int(num_clients) < 2:
        print("Error: num_clients must be an integer >= 2", file=sys.stderr)
        sys.exit(1)

    configs: list[pathlib.Path] = []
    for f in sorted(CONFIG_DIR.glob("*.yaml")):
        cfg = yaml.safe_load(f.read_text())
        if cfg.get("logging", {}).get("group") == group_name:
            configs.append(f)

    if not configs:
        print(
            f"No experiments found with logging.group='{group_name}'",
            file=sys.stderr,
        )
        sys.exit(1)

    group_dir = pathlib.Path(f"mlruns/{group_name}")
    plots_dir = group_dir / "plots"
    tracking_uri = f"sqlite:///{group_dir}/mlflow.db"
    plots_dir.mkdir(parents=True, exist_ok=True)

    run_ids: list[str] = []
    run_labels: list[str] = []
    failed: list[str] = []

    plug = sys.executable

    for config_path in configs:
        config_name = config_path.stem
        exp_plots = plots_dir / config_name
        exp_plots.mkdir(parents=True, exist_ok=True)

        print(f"\n--- {config_name} ---")

        env = {**os.environ, "MLFLOW_TRACKING_URI": tracking_uri}
        proc = subprocess.run(
            [plug, _RUN_SCRIPT, "single", str(config_path), num_clients],
            env=env,
            capture_output=True,
            text=True,
        )
        if proc.stdout:
            print(proc.stdout, end="")
        if proc.stderr:
            print(proc.stderr, end="", file=sys.stderr)

        if proc.returncode != 0:
            print("  ERROR: Experiment failed.", file=sys.stderr)
            failed.append(config_name)
            continue

        lines = [ln for ln in proc.stdout.strip().split("\n") if ln.strip()]
        run_id = lines[-1] if lines else ""
        if not run_id:
            print("  WARNING: Could not determine run_id", file=sys.stderr)
            continue

        run_ids.append(run_id)
        run_labels.append(config_name)

        plot_proc = subprocess.run(
            [
                plug, _PLOT_SCRIPT,
                "--tracking-uri", tracking_uri,
                "plot", run_id,
                "--type", "all",
                "--save-dir", str(exp_plots),
            ],
            capture_output=True,
            text=True,
        )
        for line in plot_proc.stdout.strip().split("\n"):
            if line.strip():
                print(f"  {line}")
        if plot_proc.returncode != 0:
            print("  WARNING: Plot generation failed", file=sys.stderr)

    if len(run_ids) > 1:
        comp_dir = plots_dir / "comparison"
        comp_dir.mkdir(parents=True, exist_ok=True)

        plot_proc = subprocess.run(
            [
                plug, _PLOT_SCRIPT,
                "--tracking-uri", tracking_uri,
                "compare",
                "--runs", *run_ids,
                "--names", *run_labels,
                "--type", "all",
                "--save-dir", str(comp_dir),
            ],
            capture_output=True,
            text=True,
        )
        for line in plot_proc.stdout.strip().split("\n"):
            if line.strip():
                print(f"  {line}")
        if plot_proc.returncode != 0:
            print("WARNING: Comparison plot generation failed", file=sys.stderr)

    print("\n========================================")
    print("Summary:")
    if failed:
        print(f"  Failed ({len(failed)}): {', '.join(failed)}")
    if run_ids:
        print(f"  Successful ({len(run_ids)}): {', '.join(run_labels)}")
    print("========================================")


def cmd_list(groups_only: bool = False, configs_only: bool = False) -> None:
    groups: dict[str, list[str]] = {}
    for f in sorted(CONFIG_DIR.glob("*.yaml")):
        cfg = yaml.safe_load(f.read_text())
        group = cfg.get("logging", {}).get("group")
        if group:
            groups.setdefault(group, []).append(f.name)

    if not groups:
        print("No groups found.")
        return

    if groups_only:
        for g in sorted(groups):
            print(g)
    elif configs_only:
        for confs in (groups[g] for g in sorted(groups)):
            for c in confs:
                print(c)
    else:
        for group in sorted(groups):
            print(f"{group}:")
            for conf in groups[group]:
                print(f"  - {conf}")


def main() -> None:
    parser = argparse.ArgumentParser(description="PLDP-BO experiment runner")
    sub = parser.add_subparsers(dest="command", required=True)

    p_single = sub.add_parser("single", help="Run a single experiment")
    p_single.add_argument("config_path", type=str)
    p_single.add_argument("num_clients", type=str)
    p_single.add_argument("overrides", nargs="*", help="KEY=VALUE overrides")

    p_group = sub.add_parser("group", help="Run all experiments in a group")
    p_group.add_argument("group_name", type=str)
    p_group.add_argument("num_clients", type=str)

    p_list = sub.add_parser("list", help="List available groups and configs")
    p_list.add_argument("--groups", action="store_true", help="Show only group names")
    p_list.add_argument("--configs", action="store_true", help="Show only config file paths")

    args = parser.parse_args()

    if args.command == "single":
        cmd_single(args.config_path, args.num_clients, args.overrides)
    elif args.command == "group":
        cmd_group(args.group_name, args.num_clients)
    elif args.command == "list":
        cmd_list(groups_only=args.groups, configs_only=args.configs)


if __name__ == "__main__":
    main()
