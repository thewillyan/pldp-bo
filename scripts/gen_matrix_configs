#!/usr/bin/env python3
"""Generate the §3 experimental matrix configs (EXPERIMENTS-TODO.md §3).

Emits one self-contained YAML per (dataset, partition, method) cell into
``config/experiments/`` (or ``--out-dir``), every file carrying the full §2
locked constants and ``assert_locked_config: true``, so the startup assertion
(IMPL-01) accepts them verbatim. Output is deterministic: fixed key order,
exact float literals, and a stable byte layout.

The top-level ``config_version`` key is metadata only (the sha256 over the §2
locked constants); ``load_config`` ignores unknown keys, and the tracker logs
the same value as the §4.1 ``config_version`` tag.
"""

from __future__ import annotations

import argparse
from pathlib import Path

import yaml

from src.config.locked import config_version as locked_config_version

# dataset -> partition labels (also the §4.1 experiment suffix, e.g.
# `mnist_dirichlet_0.5`). Order defines the emitted file order.
CELLS: dict[str, list[str]] = {
    "mnist": [
        "iid",
        "dirichlet_1.0",
        "dirichlet_0.5",
        "dirichlet_0.1",
        "pathological",
    ],
    "cifar100": [
        "iid",
        "dirichlet_0.5",
        "dirichlet_0.1",
        "pathological",
    ],
    "femnist": ["natural"],
}

# partition label -> (partition_type, partition_alpha | None)
PARTITIONS: dict[str, tuple[str, float | None]] = {
    "iid": ("iid", None),
    "dirichlet_1.0": ("dirichlet", 1.0),
    "dirichlet_0.5": ("dirichlet", 0.5),
    "dirichlet_0.1": ("dirichlet", 0.1),
    "pathological": ("pathological", None),
    "natural": ("writer", None),
}

# dataset -> (model name, num_classes) per Table 1 of the paper.
MODELS: dict[str, tuple[str, int]] = {
    "mnist": ("mlp", 10),
    "cifar100": ("cnn", 100),
    "femnist": ("cnn", 62),
}

# The 10 §3 methods, in the paper's order.
METHODS: list[str] = [
    "nonprivate",
    "dpfedavg_fixed",
    "fedprox_fixed",
    "pldpbo_nun",
    "pldpbo_utility",
    "pldpbo_retention",
    "pldpbo_efficiency",
    "pldpbo_perremaining",
    "pldpbo_snr",
    "pldpbo_agreement",
]

# method -> bo.optimization_metric (keys of client_app._OPTIMIZATION_METRIC_KEY_MAP).
_BO_METRICS: dict[str, str] = {
    "pldpbo_nun": "nun",
    "pldpbo_utility": "utility",
    "pldpbo_retention": "utility_retention",
    "pldpbo_efficiency": "utility_efficiency",
    "pldpbo_perremaining": "utility_per_remaining",
    "pldpbo_snr": "snr",
    "pldpbo_agreement": "logit_disagreement",
}

_FIXED_METHODS = frozenset({"dpfedavg_fixed", "fedprox_fixed"})
_BO_METHODS = frozenset(_BO_METRICS)

_HEADER = """\
# PLDP-BO §3 matrix cell: {cell} — generated by scripts/gen_matrix_configs.
# Do not edit: every value is part of the locked-config contract (§2).
"""


def _method_config(method: str) -> dict[str, dict[str, object]]:
    """Method-specific overrides (privacy/BO/aggregation/proximal mu)."""
    is_private = method != "nonprivate"
    is_bo = method in _BO_METHODS
    return {
        "privacy": {
            "enabled": is_private,
            "mechanism": "gaussian",
            "clipping_mode": "per_example",
            "update_clip_norm": 1.0,
            "accountant": "rdp",
            "accountant_mode": "rdp_native",
            "rdp_alpha": 10.0,
            "total_budget": 10.0,
            "enforce_budget": True,
            "fixed_rdp_target": 0.5,
        },
        "personalization": {"enabled": False},
        "federated": {
            "proximal_mu": 0.01 if method == "fedprox_fixed" else 0.0,
            "aggregation": "attenuation" if is_private else "plain",
        },
        "bo": {
            "enabled": is_bo,
            "optimization_metric": _BO_METRICS.get(method, "nun"),
            "rdp_min": 0.01,
            "rdp_max": 2.0,
            "grid_points": 50,
            "acquisition_penalty": 0.1,
            "gp_kernel": "matern52",
            "min_warmup": 10,
            "bounds_strategy": "global",
        },
    }


def build_config(dataset: str, partition: str, method: str) -> dict[str, object]:
    """The full YAML payload for one matrix cell (insertion order = output order)."""
    model_name, num_classes = MODELS[dataset]
    ptype, palpha = PARTITIONS[partition]
    overrides = _method_config(method)

    data: dict[str, object] = {
        "name": dataset,
        "data_dir": "./data",
        "num_clients": 100,
        "partition_type": ptype,
        "partition_min_samples": 30,
        "batch_size": 64,
        "val_split": 0.1,
    }
    if ptype == "dirichlet":
        data["partition_alpha"] = palpha

    fed: dict[str, object] = {
        "num_rounds": 200,
        "fraction_fit": 0.1,
        "fraction_evaluate": 0.0,
        "local_epochs": 5,
        "strategy": "fedavg",
        "min_fit_clients": 10,
        "min_evaluate_clients": 2,
        "min_available_nodes": 100,
        "proximal_mu": overrides["federated"]["proximal_mu"],
        "server_learning_rate": 0.01,
        "aggregation": overrides["federated"]["aggregation"],
    }

    cfg: dict[str, object] = {
        "assert_locked_config": True,
        "method": method,
        "seed": 0,
        "config_version": locked_config_version(),
        "data": data,
        "model": {"name": model_name, "num_classes": num_classes},
        "federated": fed,
        "optimizer": {
            "name": "sgd",
            "lr": 0.01,
            "momentum": 0.9,
            "weight_decay": 0.0,
            "gradient_clip_norm": 0.0,
        },
        "privacy": overrides["privacy"],
        "personalization": overrides["personalization"],
        "bo": overrides["bo"],
        "logging": {"tracker": "mlflow"},
    }
    return cfg


def write_configs(out_dir: Path) -> list[Path]:
    """Emit the 100 matrix configs; returns the written paths (sorted)."""
    out_dir.mkdir(parents=True, exist_ok=True)
    written: list[Path] = []
    for dataset, partitions in CELLS.items():
        for partition in partitions:
            for method in METHODS:
                cell = f"{dataset}_{partition}_{method}"
                path = out_dir / f"{cell}.yaml"
                payload = _HEADER.format(cell=cell) + yaml.safe_dump(
                    build_config(dataset, partition, method),
                    sort_keys=False,
                    default_flow_style=False,
                )
                path.write_text(payload)
                written.append(path)
    return sorted(written)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Generate the §3 experimental matrix configs (100 YAMLs).",
    )
    parser.add_argument(
        "--out-dir",
        type=Path,
        default=Path("config/experiments"),
        help="output directory (default: config/experiments)",
    )
    args = parser.parse_args()
    written = write_configs(args.out_dir)
    print(f"Wrote {len(written)} configs to {args.out_dir}")


if __name__ == "__main__":
    main()
